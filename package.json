{
  "name": "kursusplatform-mockup",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 4317",
    "build": "next build",
    "start": "next start",
    "deploy": "npx vercel deploy --prod --yes",
    "deploy:preview": "npx vercel deploy --yes",
    "ship": "bash scripts/ship.sh",
    "flutter:path": "echo 'export PATH=\"$HOME/flutter/bin:$PATH\"'",
    "flutter:pub": "bash -c 'export PATH=\"$HOME/flutter/bin:$PATH\"; cd apps/brandbjerg_app && flutter pub get'",
    "flutter:run:web": "bash -c 'export PATH=\"$HOME/flutter/bin:$PATH\"; cd apps/brandbjerg_app && flutter run -d chrome --dart-define=API_BASE_URL=http://127.0.0.1:4317'"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.34.0",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.6.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
